{
  "name": "agent-market-protocol",
  "version": "1.0.0",
  "description": "Autonomous AI agent economic coordination layer — Tether Hackathon Galáctica WDK Edition 1",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "demo:reject": "cross-env INJECT_BAD_DATA=true tsx src/index.ts",
    "demo:layer1": "cross-env INJECT_SCHEMA_FAIL=true tsx src/index.ts",
    "demo:layer2": "cross-env INJECT_WRONG_PROTOCOL=true tsx src/index.ts",
    "build": "tsc",
    "generate-wallets": "tsx scripts/generate-wallets.ts",
    "dev": "nodemon --exec tsx src/index.ts",
    "test-wallet": "tsx scripts/test-wallet.ts",
    "mint-usdt": "tsx scripts/mint-usdt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@tetherto/wdk": "latest",
    "@tetherto/wdk-protocol-lending-aave-evm": "latest",
    "@tetherto/wdk-wallet-evm": "latest",
    "chalk": "^5.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "uuid": "^9.0.1",
    "ws": "^8.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4"
  }
}
