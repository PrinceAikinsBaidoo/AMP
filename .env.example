# ─────────────────────────────────────────────
#  Agent Market Protocol — Environment Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# Sepolia RPC — get a free key from Alchemy (https://alchemy.com) or Infura (https://infura.io)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Anthropic API key — used by Agent B (worker analysis) and Agent C (validator verdict)
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ── Agent Wallet Seed Phrases ──────────────────
# 12-word BIP39 phrases. Generate fresh ones with: npm run generate-wallets
# Each wallet needs Sepolia ETH (for gas) and USDT (for rewards/escrow).
# Fund USDT with: npm run mint-usdt
AGENT_A_SEED_PHRASE="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
AGENT_B_SEED_PHRASE="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
AGENT_C_SEED_PHRASE="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
ESCROW_SEED_PHRASE="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"

# ── Token Addresses (Sepolia — no need to change) ──
USDT_SEPOLIA_ADDRESS=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0

# ── Optional Tuning ────────────────────────────────
# TASK_REWARD_USDT=5.0         # USDT reward Agent A locks in escrow (default: 5.0)
# TASK_DEADLINE_SECONDS=60     # Task expiry window in seconds (default: 60)

# ── Demo Flags ─────────────────────────────────────
# Inject fake 500% APY so Agent C's Layer 2 sanity check rejects the result.
# Escrow is refunded to Agent A. Run with: npm run demo:reject
# INJECT_BAD_DATA=false
